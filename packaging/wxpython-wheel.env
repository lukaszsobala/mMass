# The Python the installers and packages of all three systems are built with,
# and the wxPython wheel that goes into them. Read by the workflows in
# .github/workflows.
#
# wxPython has no PyPI wheels for Linux, nor (as of 4.3.1) for Python 3.15 on
# any system, so the wheels are built from the sdist once and kept as assets
# of the prereleases tagged wxpython-<WXPYTHON_VERSION>-<system>-r<WHEEL_REVISION>,
# <system> being linux, windows or macos (linux-wxpython-wheel.yml and
# windows-macos-wxpython-wheel.yml). A wheel is named after its Python
# version, so changing PYTHON_VERSION builds new wheels beside the old ones.
#
# Bump WHEEL_REVISION whenever a change to how a wheel is built
# (packaging/linux/install_build_deps.sh, build_wxpython_wheel.sh,
# configure_wxpython.py, the build container, the wheel workflows) should
# produce a different wheel; otherwise the existing wheels are reused.
WXPYTHON_VERSION=4.3.1
PYTHON_VERSION=3.15
WHEEL_REVISION=1
