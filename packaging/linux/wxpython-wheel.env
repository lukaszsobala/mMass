# Inputs of the wxPython wheel the Linux packages are built with, read by
# .github/workflows/linux-wxpython-wheel.yml and linux-packages.yml.
#
# The wheels are kept as assets of the prerelease tagged
# wxpython-<WXPYTHON_VERSION>-linux-r<WHEEL_REVISION>. Bump WHEEL_REVISION
# whenever a change to install_build_deps.sh, build_wxpython_wheel.sh or
# configure_wxpython.py (or to the build container) should produce a
# different wheel; otherwise the existing wheels are reused.
WXPYTHON_VERSION=4.3.1
PYTHON_VERSION=3.14
WHEEL_REVISION=1
